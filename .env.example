# Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# ── Core ─────────────────────────────────────────────────────────────
# dev | prod
ENV=dev

# Secret key for signing session cookies.
# In prod: generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in prod (the app will refuse to start if ENV=prod and this is the default).
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────
# SQLite default (dev). Switch to PostgreSQL URL in prod:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./egypt_agri.db

# ── Paths ─────────────────────────────────────────────────────────────
# Root folder for data, models, uploads (all outside the web root).
DATA_DIR=./data

# ── Optional feature switches ─────────────────────────────────────────
FEATURE_SOIL=true
FEATURE_FEEDBACK=true

# ── Kaggle (training machine only — never in the running app) ─────────
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
